---
import { Image } from 'astro:assets';
import imgTrabajo from '@/assets/images/paisajismo/instalacion-cesped-rollos-patio.jpeg';
import MainLayout from '@/layouts/MainLayout.astro';
import FinalCTA from '@/components/home/FinalCTA.astro';
import Container from '@/components/ui/Container.astro';
import {
  buildBreadcrumbSchema,
  buildLocalBusinessSchema,
  buildOrganizationSchema,
} from '@/utils/seo';

const schema = [
  buildOrganizationSchema(),
  buildLocalBusinessSchema(),
  buildBreadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Nosotros', path: '/nosotros' },
  ]),
];
---

<MainLayout
  title="Nosotros"
  description="Conoce a Lignum, equipo de jardinería en Santiago enfocado en trabajo claro, puntual y seguro para jardines, patios y áreas verdes."
  schema={schema}
>
  <section class="bg-background pt-14 md:pt-20">
    <Container>
      <div class="grid gap-8 border-b hairline pb-10 lg:grid-cols-12 lg:items-end lg:gap-12">
        <div class="lg:col-span-7">
          <p class="eyebrow">Nosotros</p>
          <h1 class="mt-3 max-w-[16ch] text-4xl font-bold md:text-5xl lg:text-6xl">
            La empresa detrás del jardín
          </h1>
        </div>
        <div class="lg:col-span-4 lg:col-start-9">
          <p class="max-w-[46ch] text-stone-700">
            Construcción y Mantenciones de Espacios Verdes Limitada es la razón social detrás de
            Lignum. Trabajamos en la Región Metropolitana y sus alrededores en mantención de áreas
            verdes, paisajismo, desmalezado, podas y tala.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-background py-12 md:py-16">
    <Container>
      {/* Imagen [nosotros], banda panorámica 21/9 (móvil 16/10): trabajo real en curso */}
      <Image
        src={imgTrabajo}
        alt="Trabajador instalando rollos de césped en un patio junto a la vivienda"
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        format="webp"
        quality={80}
        loading="lazy"
        decoding="async"
        class="aspect-[16/10] w-full rounded-lg object-cover lg:aspect-[21/9]"
      />
      <p class="mt-3.5 text-sm text-stone-600">
        Trabajo de instalación de césped en un patio residencial.
      </p>

      <div class="mt-12 grid gap-6 lg:grid-cols-12">
        <div class="max-w-[58ch] text-stone-700 lg:col-span-5 lg:col-start-7">
          <p>
            Abordamos cada intervención con una cotización clara, equipamiento adecuado y limpieza
            del lugar al terminar. Trabajamos en jardines, patios y áreas verdes, tanto en
            mantenciones como en trabajos puntuales.
          </p>
          <p class="mt-4">
            Si necesitas mantención periódica o una intervención puntual, escríbenos y conversamos
            sobre tu espacio.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <FinalCTA />
</MainLayout>
