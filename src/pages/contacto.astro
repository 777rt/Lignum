---
import MainLayout from '@/layouts/MainLayout.astro';
import QuoteForm from '@/components/quote/QuoteForm.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { AtSign, ArrowUpRight, Mail, MapPin, MessageCircle, Phone } from '@lucide/astro';
import { SITE } from '@/data/site';
import { generateWhatsAppLink } from '@/utils/whatsapp';
import { buildBreadcrumbSchema } from '@/utils/seo';

const schema = [
  buildBreadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Contacto', path: '/contacto' },
  ]),
];

const whatsappHref = generateWhatsAppLink();

const canales = [
  {
    icon: Phone,
    label: 'Teléfono',
    valor: SITE.phone,
    href: `tel:${SITE.phone.replace(/\s/g, '')}`,
  },
  {
    icon: MessageCircle,
    label: 'WhatsApp',
    valor: 'Escribir por WhatsApp',
    href: whatsappHref,
  },
  {
    icon: Mail,
    label: 'Email',
    valor: SITE.email,
    href: `mailto:${SITE.email}`,
  },
  {
    icon: AtSign,
    label: 'Instagram',
    valor: SITE.instagram,
    href: 'https://instagram.com', // PLACEHOLDER: perfil real
  },
];
---

<MainLayout title="Contacto (PLACEHOLDER)" schema={schema}>
  <section class="bg-background pt-14 md:pt-20">
    <Container>
      <div class="grid gap-8 border-b hairline pb-10 lg:grid-cols-12 lg:items-end lg:gap-12">
        <div class="lg:col-span-7" data-reveal>
          <h1 class="max-w-[16ch] text-4xl font-bold md:text-5xl lg:text-6xl">
            Hablemos de tu jardín
          </h1>
          <p class="mt-5 max-w-[58ch] text-lg text-stone-700">
            Cuéntanos qué necesitas y te responderemos a la brevedad por WhatsApp. (PLACEHOLDER)
          </p>
        </div>
        <div
          class="lg:col-span-4 lg:col-start-9 lg:text-right"
          data-reveal
          data-reveal-delay="0.06"
        >
          <Button href={whatsappHref} external size="lg">
            Solicitar cotización
          </Button>
          <p class="mt-3 text-xs text-stone-600">
            Respuesta dentro del horario de atención. (PLACEHOLDER)
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-background py-12 md:py-16">
    <Container>
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5 lg:self-start lg:sticky lg:top-28">
          <ul class="border-t hairline">
            {canales.map((canal) => (
              <li class="border-b hairline">
                <a
                  href={canal.href}
                  target={canal.href.startsWith('http') ? '_blank' : undefined}
                  rel={canal.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="group flex items-center gap-4 py-4"
                >
                  <canal.icon class="size-5 shrink-0 text-olive-500" aria-hidden="true" />
                  <span class="hidden w-24 shrink-0 text-[11px] font-medium uppercase tracking-[0.14em] text-stone-600 sm:block">
                    {canal.label}
                  </span>
                  <span class="font-medium break-words text-stone-900 transition-colors duration-fast ease-out-expo group-hover:text-forest-600">
                    {canal.valor}
                  </span>
                  <ArrowUpRight
                    class="ml-auto size-4 shrink-0 text-stone-600 transition-[transform,color] duration-fast ease-out-expo group-hover:[@media(hover:hover)_and_(pointer:fine)]:-translate-y-0.5 group-hover:[@media(hover:hover)_and_(pointer:fine)]:translate-x-0.5 group-hover:text-forest-600"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-8 border-t hairline pt-6">
            <h2 class="text-[11px] font-medium uppercase tracking-[0.18em] text-stone-600">
              Horarios de atención
            </h2>
            <dl class="mt-4 space-y-2 text-sm">
              <div class="flex justify-between gap-4">
                <dt class="text-stone-600">Lunes a viernes</dt>
                <dd class="font-medium text-stone-900">{SITE.hours.weekdays}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-stone-600">Sábado</dt>
                <dd class="font-medium text-stone-900">{SITE.hours.saturday}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-stone-600">Domingo</dt>
                <dd class="font-medium text-stone-900">{SITE.hours.sunday}</dd>
              </div>
            </dl>
          </div>

          <div class="mt-8 border-t hairline pt-6">
            <h2 class="flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.18em] text-stone-600">
              <MapPin class="size-3.5 text-olive-500" aria-hidden="true" />
              Zonas de cobertura
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-stone-700">{SITE.zones.join(' · ')}</p>
          </div>
        </div>

        <div class="lg:col-span-7" data-reveal>
          <QuoteForm />
        </div>
      </div>
    </Container>
  </section>
</MainLayout>
