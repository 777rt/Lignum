---
import { Image } from 'astro:assets';
import { Check } from '@lucide/astro';
import MainLayout from '@/layouts/MainLayout.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { SERVICES, type Service } from '@/data/services';
import { SITE } from '@/data/site';
import { buildBreadcrumbSchema, buildOrganizationSchema, buildServiceSchema } from '@/utils/seo';
import { buildWhatsAppMessage, generateWhatsAppLink } from '@/utils/whatsapp';
import { withBase } from '@/utils/links';

interface Props {
  service: Service;
}

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const whatsappHref = generateWhatsAppLink(buildWhatsAppMessage({ servicio: service.name }));
const schema = [
  buildOrganizationSchema(),
  buildServiceSchema(service),
  buildBreadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Servicios', path: '/servicios' },
    { name: service.name, path: `/servicios/${service.slug}` },
  ]),
];
const fotos = [{ src: service.image, alt: service.imageAlt }, ...service.gallery];
---

<MainLayout title={service.name} description={service.shortDescription} schema={schema}>
  <section class="bg-background pt-10 md:pt-14">
    <Container>
      <nav aria-label="Migas de pan">
        <ol class="flex flex-wrap items-center gap-2 text-xs text-stone-600">
          <li>
            <a class="hover:text-forest-600" href={withBase('/')}>
              Inicio
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a class="hover:text-forest-600" href={withBase('/servicios')}>
              Servicios
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-medium text-stone-900">
            {service.name}
          </li>
        </ol>
      </nav>

      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class="lg:col-span-7">
          <p class="eyebrow">Servicio</p>
          <h1 class="mt-3 max-w-[18ch] text-4xl font-bold md:text-5xl lg:text-6xl">
            {service.name}
          </h1>
          <p class="mt-6 max-w-[58ch] text-lg text-stone-700">{service.description}</p>
          <p class="mt-4 max-w-[58ch] text-sm text-stone-600">Atención en {SITE.coverage}.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href={whatsappHref} external size="lg">
              Cotizar este servicio
            </Button>
            <Button href="/servicios" variant="outline" size="lg">
              Volver a servicios
            </Button>
          </div>
        </div>

        <div class="lg:col-span-5">
          <Image
            src={service.image}
            alt={service.imageAlt}
            widths={[640, 960, 1280]}
            sizes="(max-width: 1024px) 100vw, 40vw"
            format="webp"
            quality={80}
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/3] w-full rounded-lg object-cover"
          />
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-surface py-12 md:py-16">
    <Container>
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <h2 class="text-2xl font-semibold tracking-[-0.01em] md:text-3xl">Qué incluye</h2>
          <p class="mt-4 max-w-[42ch] text-stone-700">
            Cada trabajo se coordina según las características del espacio y lo acordado contigo.
          </p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2 lg:col-span-7">
          {service.includes.map((item) => (
            <li class="flex items-start gap-3 rounded-lg border border-stone-200/70 bg-background px-4 py-3.5 text-sm text-stone-800">
              <Check class="mt-0.5 size-4 shrink-0 text-olive-500" aria-hidden="true" />
              {item}
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </section>

  <section class="bg-background py-12 md:py-16">
    <Container>
      <h2 class="text-2xl font-semibold tracking-[-0.01em] md:text-3xl">
        Fotografías del servicio
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {fotos.map((foto) => (
          <figure>
            <Image
              src={foto.src}
              alt={foto.alt}
              widths={[360, 640, 960]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              format="webp"
              quality={80}
              loading="lazy"
              class="aspect-[4/3] w-full rounded-lg object-cover"
            />
            <figcaption class="mt-3 text-sm leading-relaxed text-stone-600">{foto.alt}</figcaption>
          </figure>
        ))}
      </div>
    </Container>
  </section>

  <section class="bg-forest-900 py-16 text-white md:py-20">
    <Container>
      <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-8">
          <h2 class="max-w-[20ch] text-3xl font-bold md:text-4xl">¿Necesitas una cotización?</h2>
          <p class="mt-4 max-w-[52ch] text-white/70">
            Escríbenos por WhatsApp: el mensaje llegará pre-rellenado con {service.name}.
          </p>
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <Button href={whatsappHref} external variant="outline-light" size="lg">
            Solicitar cotización
          </Button>
        </div>
      </div>
    </Container>
  </section>
</MainLayout>
