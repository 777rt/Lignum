---
import {
  Axe,
  Droplets,
  Hammer,
  Layers,
  Leaf,
  PencilRuler,
  Plus,
  Scissors,
  Sprout,
  Trees,
} from '@lucide/astro';
import type { Service } from '@/data/services';

interface Props {
  service: Service;
  /** Posición en el listado (para el índice numérico). */
  index?: number;
}

const { service, index = 1 } = Astro.props;

const iconos = {
  sprout: Sprout,
  scissors: Scissors,
  axe: Axe,
  'pencil-ruler': PencilRuler,
  hammer: Hammer,
  droplets: Droplets,
  layers: Layers,
  trees: Trees,
  leaf: Leaf,
};

const Icon = iconos[service.icon as keyof typeof iconos] ?? Sprout;
const numero = String(index).padStart(2, '0');
const panelId = `${service.slug}-panel`;
const triggerId = `${service.slug}-trigger`;
/** El servicio principal (mantención) parte expandido: estado inicial del selector. */
const abierto = service.mainService === true;
---

<article
  id={service.slug}
  data-service-item
  data-slug={service.slug}
  class="group scroll-mt-24 border-t border-stone-200/70 transition-colors duration-fast ease-out-expo hover:bg-surface-subtle"
>
  <h3>
    <button
      type="button"
      id={triggerId}
      data-service-trigger
      aria-expanded={abierto ? 'true' : 'false'}
      aria-controls={panelId}
      class="flex w-full items-center gap-4 px-2 py-6 text-left md:gap-8 md:px-4 md:py-7"
    >
      <span class="w-6 shrink-0 font-mono text-xs tabular-nums text-stone-600">{numero}</span>
      <span class="flex min-w-0 flex-1 items-center gap-3 font-display text-2xl font-semibold tracking-[-0.01em] transition-colors duration-fast ease-out-expo md:text-[1.75rem]">
        <Icon class="size-5 shrink-0 text-olive-500" aria-hidden="true" />
        {service.name}
      </span>
      <Plus
        class="size-4 shrink-0 text-stone-600 transition-[color,transform] duration-fast ease-out-expo group-hover:[@media(hover:hover)_and_(pointer:fine)]:text-forest-600"
        data-service-icon
        aria-hidden="true"
      />
    </button>
  </h3>

  <div
    id={panelId}
    role="region"
    aria-labelledby={triggerId}
    data-service-panel
    data-open={abierto ? '' : undefined}
  >
    <div data-service-panel-inner class="overflow-hidden">
      <div class="px-2 pb-8 md:px-4 md:pb-10 lg:grid lg:grid-cols-12 lg:items-center lg:gap-12">
        <div class="lg:col-span-7">
          {service.image ? (
            <img
              src={service.image.src}
              alt={service.imageAlt ?? ''}
              width={service.image.width}
              height={service.image.height}
              loading="lazy"
              decoding="async"
              class="aspect-[16/10] w-full rounded-lg object-cover"
            />
          ) : (
            /* TODO: fotografía real del servicio (service.image). Aspect 16/10. */
            <div class="image-slot aspect-[16/10] rounded-lg" aria-hidden="true">
              <span class="image-slot-label">
                <Icon class="size-4" />
                Fotografía del servicio
              </span>
            </div>
          )}
        </div>
        <div class="mt-6 lg:col-span-5 lg:mt-0">
          <p class="max-w-[52ch] text-lg text-stone-700">{service.shortDescription}</p>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  /* Estado abierto: el "+" rota a "×" en verde marca (transición de estado). */
  [data-service-trigger][aria-expanded='true'] :global([data-service-icon]) {
    color: var(--color-forest-600);
    transform: rotate(45deg);
  }

  /* Panel: apertura/cierre suave vía grid-rows 0fr ↔ 1fr (expo-out, 200ms).
     Solo colapsa con JS activo (.selector-ready): sin JS todo queda visible. */
  [data-service-panel] {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 200ms var(--ease-out-expo);
  }

  [data-service-panel] > [data-service-panel-inner] {
    min-height: 0;
    overflow: hidden;
    visibility: visible;
    transition: visibility 0s;
  }

  /* Columnas del panel (foto → texto): entrada escalonada de 60ms. */
  [data-service-panel-inner] > div > * {
    transition:
      opacity 200ms var(--ease-out-expo),
      transform 200ms var(--ease-out-expo);
  }

  [data-service-panel-inner] > div > :nth-child(2) {
    transition-delay: 60ms;
  }

  :global(.selector-ready) [data-service-panel]:not([data-open]) {
    grid-template-rows: 0fr;
  }

  :global(.selector-ready) [data-service-panel]:not([data-open]) > [data-service-panel-inner] {
    visibility: hidden;
    transition: visibility 0s linear 200ms;
  }

  :global(.selector-ready)
    [data-service-panel]:not([data-open])
    [data-service-panel-inner]
    > div
    > * {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 150ms var(--ease-out-expo),
      transform 150ms var(--ease-out-expo);
    transition-delay: 0s;
  }
</style>
