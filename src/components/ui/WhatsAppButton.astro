---
import { MessageCircle } from '@lucide/astro';
import { generateWhatsAppLink } from '@/utils/whatsapp';

const href = generateWhatsAppLink();
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Solicitar cotización por WhatsApp"
  class="fixed bottom-5 right-5 z-50 inline-flex size-[52px] items-center justify-center rounded-full bg-forest-800 text-white shadow-lg shadow-forest-950/25 transition-[background-color,transform] duration-fast ease-out-expo [@media(hover:hover)_and_(pointer:fine)]:hover:-translate-y-0.5 hover:bg-forest-700 active:scale-[0.98] sm:size-auto sm:gap-2.5 sm:py-3 sm:pl-4 sm:pr-5"
>
  <MessageCircle class="size-5 shrink-0" aria-hidden="true" />
  <span class="hidden text-sm font-medium leading-tight sm:inline">Solicitar cotización</span>
</a>
