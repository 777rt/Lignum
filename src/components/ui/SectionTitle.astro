---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  heading?: 'h1' | 'h2' | 'h3';
  /** Variante sobre fondos oscuros. */
  onDark?: boolean;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  heading = 'h2',
  onDark = false,
  class: className = '',
} = Astro.props;

const Heading = heading;
const center = align === 'center';
---

<div class={`${center ? 'mx-auto max-w-[46rem] text-center' : 'max-w-[46rem]'} ${className}`}>
  {eyebrow && <p class={`eyebrow ${onDark ? 'eyebrow-on-dark' : ''}`}>{eyebrow}</p>}
  <Heading
    class:list={[
      'mt-3 text-4xl tracking-[-0.015em] text-balance md:text-5xl',
      onDark ? 'text-white' : 'text-stone-900',
    ]}
  >
    {title}
  </Heading>
  {description && (
    <p
      class:list={[
        'mt-5 max-w-[65ch] text-lg',
        center && 'mx-auto',
        onDark ? 'text-white/70' : 'text-stone-700',
      ]}
    >
      {description}
    </p>
  )}
  <slot />
</div>
