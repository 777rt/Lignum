---
/**
 * Sistema editorial de fotografía de proyectos.
 *
 * Patrón de composición por índice (feature 16/10 + vertical 3/4 + panorámica
 * 21/9). Cada ítem puede forzar su proporción con `ratio`. Diseñado para
 * recibir fotografía profesional grande sin romper la maqueta ni generar CLS.
 */

export type GalleryItem = {
  /** Ruta de la imagen dentro de /src/assets/images o URL externa. */
  src?: string;
  /** Texto alternativo obligatorio para accesibilidad. */
  alt: string;
  /** Leyenda opcional. */
  caption?: string;
  /** Categoría/etiqueta discreta, solo si aporta. */
  category?: string;
  /** Proporción forzada; por defecto sigue el patrón cíclico. */
  ratio?: 'feature' | 'portrait' | 'wide';
};

interface Props {
  items?: GalleryItem[];
}

const { items = [] } = Astro.props;

type Ratio = NonNullable<GalleryItem['ratio']>;
const pattern: Ratio[] = ['feature', 'portrait', 'wide'];

const styles: Record<Ratio, { wrap: string; frame: string }> = {
  feature: {
    wrap: 'lg:col-span-8',
    frame: 'aspect-[16/10] lg:aspect-[16/10]',
  },
  portrait: {
    wrap: 'lg:col-span-4 lg:mt-14',
    frame: 'aspect-[3/4]',
  },
  wide: {
    wrap: 'lg:col-span-12',
    frame: 'aspect-[16/9] lg:aspect-[21/9]',
  },
};

const resolved = items.map((item, index) => {
  const ratio = item.ratio ?? pattern[index % pattern.length];
  return { item, ratio, ...styles[ratio] };
});
---

{items.length === 0 ? (
  <div class="grid gap-6 lg:grid-cols-12 lg:gap-8">
    <div class="image-slot aspect-[16/10] rounded-lg lg:col-span-7" aria-hidden="true">
      <span class="image-slot-label">Fotografía de proyecto</span>
    </div>
    <div class="lg:col-span-4 lg:col-start-9 lg:self-center">
      <p class="max-w-[40ch] text-sm leading-relaxed text-stone-600">
        Espacio reservado para la fotografía profesional de los proyectos realizados. (PLACEHOLDER)
      </p>
    </div>
  </div>
) : (
  <div class="grid gap-x-6 gap-y-12 lg:grid-cols-12">
    {resolved.map(({ item, wrap, frame }) => (
      <figure class={wrap}>
        <div class={`image-slot overflow-hidden rounded-lg ${frame}`}>
          {item.src ? (
            <img
              src={item.src}
              alt={item.alt}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          ) : (
            <span class="image-slot-label">Fotografía de proyecto</span>
          )}
        </div>
        {(item.caption || item.category) && (
          <figcaption class="mt-3.5 flex items-baseline justify-between gap-4 text-sm">
            <span class="font-medium text-stone-900">{item.caption ?? item.alt}</span>
            {item.category && (
              <span class="shrink-0 font-mono text-[11px] uppercase tracking-[0.08em] text-stone-600">
                {item.category}
              </span>
            )}
          </figcaption>
        )}
      </figure>
    ))}
  </div>
)}
