---
import { Menu, X } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import { SITE } from '@/data/site';
import { generateWhatsAppLink } from '@/utils/whatsapp';
import { isCurrentPath, withBase } from '@/utils/links';

const { pathname } = Astro.url;
const whatsappHref = generateWhatsAppLink();
---

<style>
  header[data-navbar] {
    background-color: color-mix(in srgb, var(--color-background) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-stone-200) 70%, transparent);
  }

  [data-nav-link] {
    position: relative;
    color: var(--color-stone-700);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  [data-nav-link]:hover {
    color: var(--color-stone-900);
  }

  [data-nav-link][aria-current='page'] {
    color: var(--color-forest-600);
  }

  [data-brand] {
    color: var(--color-stone-900);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  [data-burger] {
    color: var(--color-stone-800);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }
</style>

<header data-navbar>
  <nav
    aria-label="Navegación principal"
    class="mx-auto flex h-16 max-w-[1400px] items-center justify-between gap-6 px-4 sm:px-6 lg:h-[72px] lg:px-8"
  >
    <a
      href={withBase('/')}
      data-brand
      class="flex shrink-0 items-center gap-2.5"
      aria-label={`Ir al inicio — ${SITE.brandLabel}`}
    >
      <img
        src={SITE.logo.path}
        alt={SITE.logo.alt}
        class="h-7 w-auto lg:h-8"
        width="262"
        height="261"
        loading="eager"
      />
      <span class="font-display text-[1.0625rem] font-bold tracking-[-0.01em]">
        {SITE.brandLabel}
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {SITE.navigation.map((link) => {
        const isCurrent = isCurrentPath(pathname, link.href);
        return (
          <li>
            <a
              href={withBase(link.href)}
              data-nav-link
              aria-current={isCurrent ? 'page' : undefined}
              class="px-3 py-2 text-sm font-medium leading-tight"
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>

    <div class="hidden lg:block">
      <Button href="/contacto" size="sm" variant="primary">
        Solicitar cotización
      </Button>
    </div>

    <button
      type="button"
      data-burger
      data-menu-button
      class="inline-flex size-11 items-center justify-center rounded-md lg:hidden"
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label="Abrir menú de navegación"
    >
      <Menu class="size-6" aria-hidden="true" data-icono-abierto />
      <X class="hidden size-6" aria-hidden="true" data-icono-cerrado />
    </button>
  </nav>

  <div id="menu-movil" data-menu hidden class="lg:hidden">
    <div class="border-t border-stone-200/70 bg-background px-4 pb-6 pt-2 sm:px-6">
      <ul>
        {SITE.navigation.map((link, index) => (
          <li class="border-b border-stone-200/70 last:border-b-0">
            <a
              href={withBase(link.href)}
              data-menu-link
              class="flex items-baseline gap-4 py-3.5 font-display text-lg font-medium text-stone-900"
            >
              <span class="font-mono text-[11px] tabular-nums text-stone-600">
                {String(index + 1).padStart(2, '0')}
              </span>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-5">
        <Button href="/contacto" size="md" class="w-full">
          Solicitar cotización
        </Button>
      </div>
      <p class="mt-4 text-xs text-stone-600">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-stone-900"
        >
          WhatsApp
        </a>
        {' · '}
        <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="hover:text-stone-900">
          {SITE.phone}
        </a>
      </p>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-navbar]');
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const iconoAbierto = document.querySelector<HTMLElement>('[data-icono-abierto]');
  const iconoCerrado = document.querySelector<HTMLElement>('[data-icono-cerrado]');

  function abrir(): void {
    if (!header || !menu || !boton) return;
    menu.removeAttribute('hidden');
    boton.setAttribute('aria-expanded', 'true');
    boton.setAttribute('aria-label', 'Cerrar menú de navegación');
    iconoAbierto?.classList.add('hidden');
    iconoCerrado?.classList.remove('hidden');
  }

  function cerrar(): void {
    if (!header || !menu || !boton) return;
    menu.setAttribute('hidden', '');
    boton.setAttribute('aria-expanded', 'false');
    boton.setAttribute('aria-label', 'Abrir menú de navegación');
    iconoAbierto?.classList.remove('hidden');
    iconoCerrado?.classList.add('hidden');
  }

  boton?.addEventListener('click', () => {
    const expandido = boton.getAttribute('aria-expanded') === 'true';
    if (expandido) {
      cerrar();
    } else {
      abrir();
    }
  });

  menu?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (target?.closest('[data-menu-link]')) cerrar();
  });

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') cerrar();
  });

  // Al pasar a desktop, el panel móvil no debe quedarse abierto.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches) cerrar();
  });
</script>
