---
import { Phone } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { SITE } from '@/data/site';
import { generateWhatsAppLink } from '@/utils/whatsapp';

const whatsappHref = generateWhatsAppLink();
const telHref = `tel:${SITE.phone.replace(/\s/g, '')}`;
---

<section class="bg-forest-900 py-16 text-white md:py-24" data-final-cta>
  <Container>
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-16">
      <div class="lg:col-span-7" data-reveal>
        <h2 class="max-w-[16ch] text-3xl font-bold md:text-5xl">
          ¿Listo para transformar tu jardín?
        </h2>
        <p class="mt-5 max-w-[52ch] text-lg text-white/70">
          Solicita una cotización sin compromiso y te responderemos a la brevedad. 
        </p>
      </div>

      <div
        class="flex flex-col items-start gap-5 lg:col-span-5 lg:items-end"
        data-reveal
        data-reveal-delay="0.06"
      >
        <div class="flex flex-wrap gap-3">
          <Button href="/contacto" variant="dark" size="lg">
            Solicitar cotización
          </Button>
          <Button href={whatsappHref} external variant="outline-light" size="lg">
            Escribir por WhatsApp
          </Button>
        </div>
        <a
          href={telHref}
          class="inline-flex items-center gap-2 text-sm text-white/50 transition-colors duration-fast ease-out-expo hover:text-white"
        >
          <Phone class="size-4" aria-hidden="true" />
          {SITE.phone}
        </a>
      </div>
    </div>
  </Container>
</section>
