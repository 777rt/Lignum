---
import imgHero from '@/assets/images/WhatsApp Image 2026-10-08 at 4.43.01 PM.jpeg';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';

const contactoHref = '/contacto';
const serviciosHref = '/servicios';
---

<section data-hero class="relative isolate overflow-hidden bg-forest-900 text-white">
  {/* Fotografía [hero principal], a sangre y centrada; el degradado actúa de scrim. */}
  <img
    src={imgHero.src}
    alt="Jardín con líneas de corte junto a una pileta, una casa y montañas al fondo"
    width={imgHero.width}
    height={imgHero.height}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10"
    style="background:
      linear-gradient(to top, rgb(15 26 18 / 0.88) 0%, rgb(15 26 18 / 0.55) 42%, rgb(15 26 18 / 0.28) 100%),
      radial-gradient(110% 85% at 78% 12%, #274a26 0%, transparent 58%),
      #162318;"
    aria-hidden="true"
  ></div>

  <Container class="relative flex min-h-[80svh] flex-col justify-center pt-16 pb-14 md:pt-20 md:pb-16">
    <div class="max-w-[46rem]">
      <p class="eyebrow eyebrow-on-dark" data-reveal data-reveal-delay="0">
        Construcción y mantención de jardines y áreas verdes en Chile.
      </p>

      <h1
        class="mt-5 text-4xl font-bold text-white sm:text-5xl lg:text-6xl"
        data-reveal
        data-reveal-delay="0.06"
      >
        LignumLtda
      </h1>

      <p class="mt-6 max-w-[58ch] text-lg text-whi  te/75" data-reveal data-reveal-delay="0.12">
        Servicio profesional de jardineria a domicilio. Cotización clara, precios transparentes
        y agenda rápida en todo Chile.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="0.18">
        <Button href={contactoHref} variant="dark" size="lg">
          Solicitar cotización
        </Button>
        <Button href={serviciosHref} variant="outline-light" size="lg">
          Ver servicios
        </Button>
      </div>
    </div>
  </Container>
</section>
