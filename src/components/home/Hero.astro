---
import { Image } from 'astro:assets';
import imgHero from '@/assets/images/jardin-residencial-piscina-montanas.jpeg';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';

const contactoHref = '/contacto';
const serviciosHref = '/servicios';
---

<section data-hero class="relative isolate overflow-hidden bg-forest-900 text-white">
  {/* Fotografía [hero principal], a sangre y centrada. */}
  <Image
    src={imgHero}
    alt="Jardín con líneas de corte junto a una pileta, una casa y montañas al fondo"
    widths={[480, 768, 1200, 1600]}
    sizes="100vw"
    format="webp"
    quality={80}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  {/* Ondas de relieve: cuatro franjas boscosas que reemplazan al antiguo scrim degradado. */}
  <svg
    class="pointer-events-none absolute inset-0 z-0 h-full w-full"
    viewBox="0 0 1440 900"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      fill="var(--color-forest-700)"
      opacity="0.42"
      d="M0 186c214-72 398 34 610-8 208-41 354-128 548-84 182 42 226 128 282 160V900H0Z"
    />
    <path
      fill="var(--color-forest-800)"
      opacity="0.68"
      d="M0 330c196-62 366 20 556-14 194-35 326-118 506-80 168 35 278 114 378 132V900H0Z"
    />
    <path
      fill="var(--color-forest-900)"
      opacity="0.86"
      d="M0 492c188-48 354 30 540 0 188-30 318-104 490-72 158 30 284 96 410 112V900H0Z"
    />
    <path
      fill="var(--color-forest-950)"
      opacity="0.94"
      d="M0 668c212-40 400 30 600 2 184-26 330-84 492-56 150 26 276 76 348 88V900H0Z"
    />
  </svg>

  <Container class="relative z-10 flex min-h-[80svh] flex-col justify-center pt-16 pb-14 md:pt-20 md:pb-16">
    <div class="max-w-[46rem]">
      <p class="eyebrow eyebrow-on-dark">Mantención, poda y paisajismo</p>

      <h1 class="mt-5 text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
        Jardinería en Santiago con cotización clara
      </h1>

      <p class="mt-6 max-w-[58ch] text-lg text-white/75">
        Servicio a domicilio para particulares, condominios y empresas. Mantención de áreas verdes,
        desmalezado, podas y tala de árboles.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <Button href={contactoHref} variant="dark" size="lg">
          Solicitar cotización
        </Button>
        <Button href={serviciosHref} variant="outline-light" size="lg">
          Ver servicios
        </Button>
      </div>
    </div>
  </Container>
</section>
