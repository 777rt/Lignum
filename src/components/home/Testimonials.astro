---
import Container from '@/components/ui/Container.astro';
---

<section class="bg-sage-100 py-16 md:py-20" data-testimonials>
  <Container width="narrow">
    <div class="text-center" data-reveal>
      <span class="font-display text-6xl leading-none text-olive-500" aria-hidden="true">
        “
      </span>
      <blockquote class="mx-auto mt-3 max-w-[44ch] font-display text-xl italic leading-snug text-stone-800 md:text-2xl">
        Los testimonios reales de clientes se agregarán aquí posteriormente. (PLACEHOLDER)
      </blockquote>
      <p class="mt-6 text-sm text-stone-600">Cliente verificado (PLACEHOLDER)</p>
    </div>
  </Container>
</section>
