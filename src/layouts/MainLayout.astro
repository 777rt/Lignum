---
import '@/styles/global.css';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import { buildPageTitle, buildCanonicalURL, type JsonLd } from '@/utils/seo';
import { SITE } from '@/data/site';
import { withBase } from '@/utils/links';

interface Props {
  title: string;
  description?: string;
  /** Ruta para la URL canónica (por defecto, la ruta actual). */
  canonicalPath?: string;
  /** Imagen para Open Graph / Twitter. Debe ser una URL o ruta absoluta. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Estructuras JSON-LD (Schema.org) a incluir en esta página. */
  schema?: JsonLd[];
}

const {
  title,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
  image = SITE.ogImage,
  type = 'website',
  noindex = false,
  schema = [],
} = Astro.props;

const fullTitle = buildPageTitle(title);
const canonical = buildCanonicalURL(canonicalPath);
const ogImage = image ? new URL(image, SITE.url).toString() : '';
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={SITE.themeColor} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Preparación de reveals: solo si el usuario no pide movimiento reducido.
        Sin JS o con reduced-motion, el contenido queda visible por defecto. */}
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-ready');
      }
    </script>
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <slot name="head" />

    {schema.map((object) => (
      <script type="application/ld+json" set:html={JSON.stringify(object)} />
    ))}
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-forest-800 focus:px-4 focus:py-2.5 focus:text-sm focus:font-medium focus:text-white focus:shadow-lg"
    >
      Saltar al contenido principal
    </a>

    <Navbar />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />

    {/* Inicializa los reveals de toda la página en un único punto: cualquier
        elemento con [data-reveal] queda animado sin depender del componente. */}
    <script>
      import { initReveal } from '@/utils/animation';

      initReveal(document);
    </script>
  </body>
</html>
